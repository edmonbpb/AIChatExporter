# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=MY_GEMINI_API_KEY

# GOOGLE_CLIENT_ID: OAuth 2.0 client id handed to Credential Manager for Google sign-in.
# Use the "Web application" client id of the Google Cloud project whose *Android* OAuth client
# registers this app's package name plus the SHA-1 of the signing certificate.
# Left blank (or MY_...) the sign-in button stays disabled and guest mode is the only entry.
GOOGLE_CLIENT_ID=MY_GOOGLE_CLIENT_ID
