<?xml version="1.0" encoding="utf-8"?><!--
  Data-extraction rules for Android 12 (API 31) and newer; referenced by
  android:dataExtractionRules in AndroidManifest.xml.

  Android 12 split the old single backup rule set into two independently configurable channels:
  cloud-backup (Google One restore) and device-transfer (D2D migration to a new handset).
  Both channels are closed here, because device-transfer is the one users rarely expect to
  carry a chat archive to another phone.

  The manifest also sets android:allowBackup="false", so on this build no backup agent runs at
  all. These entries are defence in depth for the case where the flag gets flipped back (fork,
  vendor overlay, test manifest merger): the artifacts named below must never leave the device.

  Real names taken from source, not invented:
    database   aichat_exporter.db       data/local/AppDatabase.kt:35  (Room, plus -wal/-shm)
    sharedpref aichat_auth_prefs.xml    ui/viewmodel/MainViewModel.kt:79 (user_id, reader_api_key,
                                        custom Gemini key override - auth state and both keys)
    file       documents/               domain/exporter/DocumentExporter.kt:43 and
                                        ui/viewmodel/MainViewModel.kt:349 (exported PDF/DOCX/... plus
                                        the local Backup ZIP/JSON archive staged here)
    file       resume_draft.json        data/local/ResumeDraftStore.kt:53 (full open conversation,
                                        plus its .tmp staging twin)
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="database" path="aichat_exporter.db" />
        <exclude domain="database" path="aichat_exporter.db-wal" />
        <exclude domain="database" path="aichat_exporter.db-shm" />
        <exclude domain="sharedpref" path="aichat_auth_prefs.xml" />
        <exclude domain="file" path="documents/" />
        <exclude domain="file" path="resume_draft.json" />
        <exclude domain="file" path="resume_draft.json.tmp" />
        <exclude domain="external" path="documents/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="database" path="aichat_exporter.db" />
        <exclude domain="database" path="aichat_exporter.db-wal" />
        <exclude domain="database" path="aichat_exporter.db-shm" />
        <exclude domain="sharedpref" path="aichat_auth_prefs.xml" />
        <exclude domain="file" path="documents/" />
        <exclude domain="file" path="resume_draft.json" />
        <exclude domain="file" path="resume_draft.json.tmp" />
        <exclude domain="external" path="documents/" />
    </device-transfer>
</data-extraction-rules>
